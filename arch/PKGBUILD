pkgname=frontmatter-mcp-bin
pkgver=0.2.1
pkgrel=1
pkgdesc='Markdown frontmatter editor and MCP server'
arch=('x86_64')
url='https://github.com/delfianto/frontmatter-mcp'
license=('MIT')
depends=('glibc' 'libgcc')
provides=("frontmatter-mcp=$pkgver")
conflicts=('frontmatter-mcp')
options=('!strip' '!debug')
_archive="frontmatter-mcp-v$pkgver-linux-x86_64"
source=("$url/releases/download/v$pkgver/$_archive.tar.gz")
sha256sums=('3a91dd2914f0263478f1536a624016c6ff5d03137a4c08350c26089bca30904a')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 frontmatter "$pkgdir/usr/bin/frontmatter"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
